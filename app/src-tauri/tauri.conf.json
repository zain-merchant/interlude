{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oss-dj",
  "version": "0.1.0",
  "identifier": "dev.ossdj.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "oss-dj",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 760,
        "backgroundColor": "#0b0c0f",
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../crates/controller/mappings/": "controllers/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRkZDQzNGMkZCRUEzQTEKUldTaG83NHZQOHovWGhKSDVHNnk0WHowK2JsYmhoc1ZnbVM4Y1FOTEI0V3g5eG8vOSt2UGRNNnQK",
      "endpoints": [
        "https://github.com/zain-merchant/oss-dj-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
