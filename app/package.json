{
  "name": "interlude-ui",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "config": {
    "heroClipsRepo": "zain-merchant/interlude"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "node --test src/lib/*.test.js",
    "tauri": "tauri",
    "dev:site": "vite --config demo/vite.config.js",
    "build:site": "vite build --config demo/vite.config.js",
    "clips": "node demo/segments/record.mjs",
    "clips:fetch": "node scripts/hero-clips.mjs fetch",
    "clips:publish": "node scripts/hero-clips.mjs publish",
    "site:pages": "node scripts/hero-clips.mjs pages",
    "build:site:all": "npm run build:site && node scripts/hero-clips.mjs fetch && node demo/segments/record.mjs --if-changed"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cn": "^0.5.2",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.53.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.0"
  }
}
